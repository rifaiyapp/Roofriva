---
interface Props { id?: string; source?: string; }
const {id='hero-quote',source='homepage-hero-quote'} = Astro.props;
---
<form id={id} class="lead-form" method="dialog" novalidate aria-label="Request a roofing estimate">
 <input type="hidden" name="form_source" value={source}/>
 <div class="honeypot" aria-hidden="true"><label for={`${id}-website`}>Website</label><input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off"/></div>

 <label class="sr-only" for={`${id}-name`}>Your name (required)</label>
 <input id={`${id}-name`} name="name" autocomplete="name" required placeholder="Your name"/>

 <label class="sr-only" for={`${id}-phone`}>Phone number (required)</label>
 <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" required placeholder="(800) 555-0198"/>

 <label class="sr-only" for={`${id}-email`}>Email address</label>
 <input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="hello@example.com"/>

 <label class="sr-only" for={`${id}-zip`}>ZIP Code</label>
 <div class="zip-field">
  <input id={`${id}-zip`} name="zip" autocomplete="postal-code" inputmode="numeric" placeholder="ZIP Code"/>
  <span class="zip-accent" aria-hidden="true"><i></i><i></i><i></i></span>
 </div>

 <label class="sr-only" for={`${id}-message`}>Tell us about your roof</label>
 <textarea id={`${id}-message`} name="message" rows="4" placeholder="Tell us about your roof"></textarea>

 <button type="submit" class="button rooflume-submit">GET FREE INSPECTION</button>
 <p class="form-reassurance">No spam. No obligation.</p>
 <p class="form-status" role="status" aria-live="polite" aria-atomic="true"></p>
 <noscript><p>Please enable JavaScript to send this form, or use the phone or email below.</p></noscript>
</form>
<script>
 import { connectLeadForm } from '../scripts/lead-form';
 document.querySelectorAll<HTMLFormElement>('.lead-form').forEach(connectLeadForm);
</script>
<style is:global>
 .estimate-card .lead-form{
  background:transparent!important;
  padding:28px 22px 24px!important;
  gap:14px!important;
 }
 .estimate-card .lead-form>input:not([type=hidden]),
 .estimate-card .lead-form>textarea,
 .estimate-card .zip-field>input{
  width:100%!important;
  min-height:66px!important;
  padding:16px 18px!important;
  border:1px solid #d4dbe3!important;
  border-radius:0!important;
  background:#fff!important;
  color:#2b2b2b!important;
  box-shadow:none!important;
  font-size:17px!important;
  line-height:1.2!important;
  font-weight:400!important;
 }
 .estimate-card .lead-form>textarea{
  min-height:94px!important;
  resize:vertical!important;
  padding-top:18px!important;
 }
 .estimate-card .lead-form input::placeholder,
 .estimate-card .lead-form textarea::placeholder{
  color:#858585!important;
  opacity:1!important;
 }
 .estimate-card .zip-field{
  position:relative;
  width:100%;
 }
 .estimate-card .zip-field>input{
  padding-right:58px!important;
 }
 .estimate-card .zip-accent{
  position:absolute;
  top:50%;
  right:24px;
  width:29px;
  height:29px;
  transform:translateY(-50%);
  display:flex;
  align-items:center;
  justify-content:center;
  gap:3px;
  border-radius:6px;
  background:var(--red,#c60008);
  box-shadow:0 2px 0 rgba(0,0,0,.12);
  pointer-events:none;
 }
 .estimate-card .zip-accent i{
  width:3px;
  height:3px;
  border-radius:50%;
  background:#fff;
 }
 .estimate-card .rooflume-submit{
  width:100%!important;
  min-height:68px!important;
  margin:5px 0 0!important;
  padding:15px 36px!important;
  border:0!important;
  border-radius:0!important;
  background:var(--red,#c60008)!important;
  color:#fff!important;
  box-shadow:none!important;
  clip-path:polygon(9% 0,100% 0,91% 100%,0 100%);
  font-size:17px!important;
  line-height:1!important;
  font-weight:800!important;
  letter-spacing:.035em!important;
  text-transform:uppercase;
 }
 .estimate-card .rooflume-submit:hover,
 .estimate-card .rooflume-submit:focus-visible{
  background:#e00008!important;
 }
 .estimate-card .form-reassurance{
  margin:-2px 0 0!important;
  color:#fff!important;
  text-align:center;
  font-size:13px!important;
  line-height:1.2!important;
  font-weight:700!important;
  letter-spacing:.01em!important;
 }
 .estimate-card .form-status{
  margin:0!important;
  color:#fff!important;
  text-align:center;
  font-size:12px!important;
 }
 .estimate-card .form-status:empty{display:none!important}

 @media(max-width:600px){
  .estimate-card .lead-form{padding:22px 16px 20px!important;gap:12px!important}
  .estimate-card .lead-form>input:not([type=hidden]),
  .estimate-card .lead-form>textarea,
  .estimate-card .zip-field>input{min-height:58px!important;font-size:16px!important}
  .estimate-card .lead-form>textarea{min-height:96px!important}
  .estimate-card .rooflume-submit{min-height:62px!important;font-size:15px!important}
 }
</style>
