---
interface Props { light?: boolean; class?: string; }
const { light = false, class: className = '' } = Astro.props;
---
{light ? (
  <img
    class:list={['brand-mark','brand-logo',className]}
    src="/assets/brand/logolight.png"
    alt=""
    width="1390"
    height="1033"
    decoding="async"
  />
) : (
  <svg class:list={['brand-mark', className]} viewBox="0 0 240 230" fill="none" aria-hidden="true">
    <path d="M113 5 172 99 149 135 125 97 135 80 113 44 85 89 169 223 130 223 46 89Z" fill="#2b2c2c" />
    <path d="M69 114 10 211 109 211 145 152 124 120 87 179 65 179 90 147Z" fill="#c60009" />
    <path d="M171 119 237 224 197 224 151 151Z" fill="#2b2c2c" />
    <path d="m143 51 30 48-23 37-19-30 9-14-17-26Z" fill="#b90007" />
  </svg>
)}
<style is:global>
  .brand > span{display:none!important}
  .site-header .brand-logo{width:150px!important;height:auto!important;max-height:118px;object-fit:contain}
  .site-footer .brand-logo{width:190px!important;height:auto!important;max-height:145px;object-fit:contain}
  .hero-house{top:0!important}
  @media(max-width:900px){
    .site-header .brand-logo{width:115px!important;max-height:88px}
    .site-footer .brand-logo{width:165px!important;max-height:126px}
  }
  @media(max-width:600px){
    .site-header .brand-logo{width:100px!important;max-height:76px}
    .site-footer .brand-logo{width:155px!important;max-height:118px}
  }
</style>
