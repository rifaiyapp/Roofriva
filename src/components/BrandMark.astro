---
interface Props { light?: boolean; class?: string; }
const { light = false, class: className = '' } = Astro.props;
---
{light ? (
  <img
    class:list={['brand-mark','brand-logo',className]}
    src="/assets/brand/logolight.png"
    alt=""
    width="1390"
    height="1033"
    decoding="async"
  />
) : (
  <svg class:list={['brand-mark', className]} viewBox="0 0 240 230" fill="none" aria-hidden="true">
    <path d="M113 5 172 99 149 135 125 97 135 80 113 44 85 89 169 223 130 223 46 89Z" fill="#2b2c2c" />
    <path d="M69 114 10 211 109 211 145 152 124 120 87 179 65 179 90 147Z" fill="#c60009" />
    <path d="M171 119 237 224 197 224 151 151Z" fill="#2b2c2c" />
    <path d="m143 51 30 48-23 37-19-30 9-14-17-26Z" fill="#b90007" />
  </svg>
)}
<style is:global>
  .brand > span{display:none!important}
  .site-header .brand-logo{width:150px!important;height:auto!important;max-height:110px!important;object-fit:contain}
  .site-footer .brand-logo{width:190px!important;height:auto!important;max-height:145px;object-fit:contain}
  .hero-house{top:0!important}

  /* Header row 1 — match the supplied reference proportions. */
  .site-header .header-top{height:120px!important}
  .site-header .header-address,
  .site-header .header-phone{gap:16px!important;align-items:center!important;color:#fff!important}

  .site-header .header-address .icon{
    width:47px!important;
    height:55px!important;
    stroke:#fff!important;
    stroke-width:1.25!important;
    flex:none!important;
  }
  .site-header .header-phone .icon{
    width:50px!important;
    height:50px!important;
    stroke:#fff!important;
    stroke-width:1.25!important;
    fill:none!important;
    flex:none!important;
  }

  .site-header .header-address span,
  .site-header .header-phone span{display:block!important;line-height:1.2!important}

  .site-header .header-address small{
    display:block!important;
    margin:0 0 5px!important;
    font-size:15px!important;
    line-height:1!important;
    font-weight:600!important;
    letter-spacing:.01em!important;
    color:#fff!important;
  }
  .site-header .header-address strong{
    display:block!important;
    max-width:225px!important;
    white-space:normal!important;
    font-size:12.5px!important;
    line-height:1.38!important;
    font-weight:400!important;
    letter-spacing:.01em!important;
    color:rgba(255,255,255,.92)!important;
  }

  .site-header .header-phone small{
    display:block!important;
    margin:0 0 4px!important;
    font-size:12px!important;
    line-height:1!important;
    font-weight:400!important;
    letter-spacing:.01em!important;
    color:rgba(255,255,255,.9)!important;
  }
  .site-header .header-phone strong{
    display:block!important;
    white-space:nowrap!important;
    font-size:20px!important;
    line-height:1!important;
    font-weight:700!important;
    letter-spacing:.01em!important;
    color:#fff!important;
  }

  /* Red branded icon before every desktop navigation item. */
  .site-header .header-nav a{gap:8px!important}
  .site-header .header-nav a::before{
    content:'';
    display:block;
    width:11px;
    height:10px;
    flex:none;
    background:#d40009;
    clip-path:polygon(50% 0,100% 43%,84% 43%,84% 100%,57% 100%,57% 67%,43% 67%,43% 100%,16% 100%,16% 43%,0 43%);
  }
  .site-header .header-nav a:hover::before,
  .site-header .header-nav a:focus-visible::before{background:#ff1820}

  /* Estimate heading: use the uploaded dark logo and a clean inset red border. */
  .estimate-heading{
    position:relative!important;
    border:0!important;
    padding:45px 40px!important;
    overflow:hidden!important;
  }
  .estimate-heading::before{
    content:'';
    position:absolute;
    inset:15px;
    border:1px solid #c60008;
    pointer-events:none;
    z-index:1;
  }
  .estimate-heading>div{
    position:relative;
    z-index:2;
  }
  .estimate-heading>.brand-mark{
    display:none!important;
  }
  .estimate-heading::after{
    content:'';
    position:absolute;
    right:28px;
    top:24px;
    width:210px;
    height:155px;
    background:url('/assets/brand/logodark.png') center/contain no-repeat;
    z-index:2;
    pointer-events:none;
  }

  @media(max-width:900px){
    .site-header .brand-logo{width:115px!important;max-height:88px!important}
    .site-footer .brand-logo{width:165px!important;max-height:126px}
  }
  @media(max-width:600px){
    .site-header .brand-logo{width:100px!important;max-height:76px!important}
    .site-footer .brand-logo{width:155px!important;max-height:118px}
    .estimate-heading::after{right:22px;top:30px;width:165px;height:130px}
  }
</style>
