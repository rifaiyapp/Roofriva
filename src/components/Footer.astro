---
import { site, services } from '../data/site';
---
<footer class="footer">
  <div class="shell footer-brand-center">
    <img src="/assets/logo-light.svg" alt="ROOFRIVA Roofing"/>
    <p>{site.tagline}</p>
    <div class="footer-contact-line"><a href={site.phoneHref}>{site.phone}</a><span>{site.email}</span><span>{site.serviceArea} — Demo</span></div>
    <div class="footer-social" aria-label="Demo social placeholders"><span>f</span><span>◎</span><span>▶</span><span>in</span></div>
  </div>
  <div class="shell footer-links-grid">
    <div><h3>Company</h3><a href="/about/">About</a><a href="/projects/">Projects</a><a href="/reviews/">Reviews</a><a href="/faq/">FAQ</a><a href="/contact/">Contact</a></div>
    <div><h3>Services</h3>{services.slice(0,5).map(s => <a href={`/services/${s.slug}/`}>{s.title}</a>)}</div>
    <div><h3>Resources</h3><a href="/roofing-materials/">Roofing Materials</a><a href="/roofing-process/">Roofing Process</a><a href="/faq/">Questions & Answers</a></div>
    <div><h3>Legal</h3><a href="/privacy-policy/">Privacy</a><a href="/terms/">Terms</a><a href="/cookie-policy/">Cookies</a><a href="/accessibility/">Accessibility</a><a href="/website-disclaimer/">Disclaimer</a></div>
  </div>
  <div class="shell footer-bottom"><span>© 2026 ROOFRIVA. Demo Roofing Website Template by Shibga Media.</span><span>Business information shown is fictional and provided for template presentation purposes only.</span></div>
</footer>